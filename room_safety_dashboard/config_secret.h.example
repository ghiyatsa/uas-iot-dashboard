/*
 * config_secret.h.example - Template credentials.
 *
 * Cara pakai:
 *   1. Salin file ini: cp config_secret.h.example config_secret.h
 *   2. Isi nilai yang sebenarnya di config_secret.h
 *   3. JANGAN commit config_secret.h ke Git!
 */

#ifndef CONFIG_SECRET_H
#define CONFIG_SECRET_H

// ====================== WIFI ======================
#define WIFI_SSID       "your-wifi-ssid"
#define WIFI_PASSWORD   "your-wifi-password"

// ====================== MQTT (HiveMQ Cloud, TLS) ======================
#define MQTT_HOST       "xxxx.s1.eu.hivemq.cloud"
#define MQTT_USERNAME   "your-mqtt-username"
#define MQTT_PASSWORD   "your-mqtt-password"

// ====================== TELEGRAM ======================
#define TELEGRAM_BOT_TOKEN  "1234567890:AAAXXXXXXXXXXXXXXXXXXXXXXXXXXXXXXXXX"
#define TELEGRAM_CHAT_ID    "your-chat-id"

#endif  // CONFIG_SECRET_H
